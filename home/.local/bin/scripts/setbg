#!/bin/sh

bgloc="$XDG_DATA_HOME/bg"
postrun="$XDG_CONFIG_HOME/wal/postrun"
resolution="$(xrandr --query | awk '/ primary / {print $4}' | cut -d'+' -f1)"
cache_dir="$XDG_CACHE_HOME/wallpapers/cache/$resolution"
wall_config="$XDG_CONFIG_HOME/wallpapers/config.toml"

silent=''
while getopts "s" o; do
    case "${o}" in
    s) silent='1' ;;
    *) ;;
    esac
done

shift $((OPTIND - 1))

if [ -n "$silent" ]; then
    exec >/dev/null 2>&1
fi

notify() {
    [ -z "$silent" ] && notify-send -i "$bgloc" "$1"
}

err() {
    [ -z "$silent" ] && notify-send "🖼️ Error" "$1"
    exit 1
}

random_wallpaper() {
    wallpapers random --print | sed -n 's/.*"\(.*\)".*/\1/p' | head -n 1
}

apply_wallpaper() {
    [ -n "$1" ] || err "No wallpaper found to apply."
    ln -sf "$1" "$bgloc" || err "Failed to link wallpaper."
    case "$2" in
    xwallpaper) xwallpaper --zoom "$1" ;;
    preview) wallpapers preview "$1" ;;
    *) ;;
    esac
}

if [ -z "$1" ]; then
    trueloc="$(random_wallpaper)"
    setter=""
    apply_wallpaper "$trueloc" "$setter"
    notify "Random wallpaper chosen."
else
    trueloc="$(readlink -f "$1")" &&
        case "$(file --mime-type -b "$trueloc")" in
        image/*)
            cached="$cache_dir/$(basename "$trueloc").png"
            if [ -f "$cached" ]; then
                trueloc="$cached"
                setter="xwallpaper"
            else
                setter="preview"
            fi
            apply_wallpaper "$trueloc" "$setter"
            notify "Changing wallpaper."
            ;;
        inode/directory)
            originals_directory="$(grep '^originals_directory' "$wall_config" | cut -d'"' -f2)"
            if [ "${trueloc%/}/" = "${originals_directory%/}/" ]; then
                trueloc="$(random_wallpaper)"
                setter=""
            else
                trueloc="$(find "$trueloc" -iregex '.*\.\(jpg\|jpeg\|png\|gif\)$' -type f | shuf -n 1)"
                setter="preview"
            fi
            apply_wallpaper "$trueloc" "$setter"
            notify "Random wallpaper chosen."
            ;;
        *) err "Not a valid image or directory." ;;
        esac
fi

if wal -c && wal --cols16 lighten -a 80 -n -i "$(readlink -f "$bgloc")" -o "$postrun"; then
    pidof dwm >/dev/null && xdotool key super+F5
    pidof st | xargs kill -s USR1

else
    err "pywal failed to generate a colorscheme."
fi
