# shellcheck shell=bash
# vim: ft=bash

smallfetch() {
    fastfetch \
        --config "$XDG_CONFIG_HOME/fastfetch/small.jsonc" \
        "$@"
}

onefetch() {
    command onefetch \
        --disabled-fields churn \
        --number-of-authors 10 \
        --email \
        --include-hidden \
        --no-color-palette \
        --nerd-fonts \
        "$@"
}

wget() {
    command wget \
        --hsts-file="$XDG_CACHE_HOME/wget-hsts" \
        --continue \
        --show-progress \
        "$@"
}

dps() {
    docker ps -a \
        --format 'table {{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Command}}\t{{.RunningFor}}' \
        "$@"
}

dpsp() {
    docker ps -a \
        --format 'table {{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Command}}\t{{.RunningFor}}\t{{.Ports}}' \
        "$@"
}

nvm_activate() {
    source_if_exists "/usr/share/nvm/init-nvm.sh"
}

nvm_deactivate() {
    unset -f nvm
    unset NVM_DIR NVM_BIN NVM_INC
    PATH=$(printf '%s' "$PATH" | awk -v RS=: -v ORS=: '$0 !~ /\/nvm\// {print}' | sed 's/:$//')
    hash -r
}
